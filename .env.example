# Optional. Search and matching work without any keys.
# Copy to .env locally; never commit real secrets.

# Adzuna — https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Reed — https://www.reed.co.uk/developers
REED_API_KEY=

# LinkedIn — no public job-search API. Do not put li_at / session cookies here;
# cookie fetch is not implemented. Optional: an RSS/Atom/JSON feed URL you host
# or that a documented partner gave you. The tool will GET this URL only.
LINKEDIN_JOBS_FEED_URL=

# LinkedIn Talent Job Posting API is partner-only and posts jobs; it cannot
# search openings for candidates. Token is accepted but unused for search.
LINKEDIN_ACCESS_TOKEN=

# Naukri — no public candidate job-search API (Info Edge). Do not put site
# session cookies here. Optional: RSS/Atom/JSON feed URL you are allowed to GET.
NAUKRI_JOBS_FEED_URL=

# Placeholder until Naukri documents a candidate search API. Unused for search.
NAUKRI_API_KEY=
